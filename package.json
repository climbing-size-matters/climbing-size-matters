{
  "name": "climbing-size-matters",
  "version": "0.1.0",
  "private": true,
  "description": "mountain project enhancements",
  "type": "module",
  "keywords": [
    "browser",
    "extension",
    "climbing",
    "gear",
    "mountainproject"
  ],
  "homepage": "https://github.com/louis-brann/climbing-size-matters#readme",
  "bugs": {
    "url": "https://github.com/louis-brann/climbing-size-matters/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louis-brann/climbing-size-matters.git"
  },
  "license": "MIT",
  "author": "Louis Brann, Eric Warren",
  "main": "content-script.js",
  "packageManager": "pnpm@9.12.1",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test-watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "e2e": "wxt build && playwright test",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "format": "prettier . --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/chrome": "0.0.315",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.0",
    "globals": "15.13.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "web-ext": "10.8.0",
    "wxt": "0.21.5"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --check --ignore-unknown",
      "eslint"
    ],
    "!(*.js|*.ts|*.jsx|*.tsx)": [
      "prettier --check --ignore-unknown --no-error-on-unmatched-pattern"
    ]
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
